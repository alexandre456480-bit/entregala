# Copie para .env. Nunca versionar credenciais reais.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Também reconhecidos: SUPABASE_ID e SUPABASE_PUBLISHABE_KEY (arquivo original).
# Somente servidor, para provisionar motoristas e administrador:
SUPABASE_SECRET_KEY=
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:4200
# Duas chaves distintas: pública para mapas; privada somente no servidor.
GEOAPIFY_MAPS_KEY=
GEOAPIFY_SERVER_KEY=
DATABASE_URL=
# Apenas provisionamento controlado via npm run admin:provision:
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
